# Web (Vite) — unchanged for new_balan_fe
VITE_API_BASE_URL=https://devapi.newbalanpharmacy.com
VITE_API_PREFIX=/api/v1
VITE_PROD_CHECK=false

# Expo reads EXPO_PUBLIC_* in JS; app.config.js also maps VITE_API_* → expo.extra.
# After changing API URL, restart Metro: npx expo start --clear
#EXPO_PUBLIC_ENVIRONMENT=http://127.0.0.1:8000
EXPO_PUBLIC_API_ORIGIN=https://devapi.newbalanpharmacy.com
EXPO_PUBLIC_API_PREFIX=/api/v1

# Shop service area — customer addresses & checkout use this city/state/PIN (fixed; not editable in app)
EXPO_PUBLIC_SHOP_CITY=Palakkad
EXPO_PUBLIC_SHOP_STATE=Kerala
EXPO_PUBLIC_SHOP_PINCODE=678001