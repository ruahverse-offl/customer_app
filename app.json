{
  "expo": {
    "name": "New Balan Medical",
    "slug": "new_balan_apk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/new_balan_logo.png",
    "scheme": "newbalan",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#0056b3",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0056b3"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/new_balan_logo.png",
        "backgroundColor": "#0056b3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.newbalan.medical",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
