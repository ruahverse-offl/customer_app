# Option A — Expo public (inlined in JS bundle)
# EXPO_PUBLIC_API_ORIGIN=https://devapi.example.com
# EXPO_PUBLIC_API_PREFIX=/api/v1

# Option B — same names as Vite web app (read by app.config.js into expo.extra)
# VITE_API_BASE_URL=https://devapi.example.com
# VITE_API_PREFIX=/api/v1

# Android emulator hitting your PC’s localhost API:
# EXPO_PUBLIC_API_ORIGIN=http://10.0.2.2:8000
