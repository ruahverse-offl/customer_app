# Copy this file to .env and fill in real values.
# .env is gitignored — never commit production credentials.

# ── API ──────────────────────────────────────────────────────────────────────
# Backend origin, no trailing slash.
#   Production:     https://devapi.newbalanpharmacy.com
#   Android emu:    http://10.0.2.2:8000
#   USB device:     http://<your-LAN-IP>:8000   (e.g. http://192.168.1.42:8000)
API_ORIGIN=https://devapi.newbalanpharmacy.com
API_PREFIX=/api/v1

# Optional aliases for sharing this file with the marketing site (Vite reads
# VITE_*-prefixed vars). The Flutter app prefers API_ORIGIN / API_PREFIX above
# and only consults these as a fallback.
VITE_API_BASE_URL=https://devapi.newbalanpharmacy.com
VITE_API_PREFIX=/api/v1

# ── Shop metadata ────────────────────────────────────────────────────────────
# Surfaced on the login subtitle, home hero badge, free-delivery promo, and
# the locked "Delivery Area" field on the address form. Change here when
# moving the shop or adding a new branch.
SHOP_CITY=Thoothukudi
SHOP_STATE=Tamil Nadu
SHOP_PINCODE=628001
